{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },

  "Jwt": {
    "Issuer": "InsurancePlatform",
    "Audience": "InsurancePortal",
    "Key": "InsurancePlatform-Development-Key-2026-Secure-ChangeMe"
  },

  "ReverseProxy": {
    "Routes": {
      "customer-route": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },

      "quote-route": {
        "ClusterId": "quote-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": {
          "Path": "/api/quotes/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },

      "auto-quote-route": {
        "ClusterId": "quote-cluster",
        "AuthorizationPolicy": "AgentOnly",
        "Match": {
          "Path": "/api/quotes/auto",
          "Methods": [ "POST" ]
        }
      }
    },

    "Clusters": {
      "customer-cluster": {
        "Destinations": {
          "customer-service": {
           "Address": "https://customer-service.livelyisland-a6b04717.eastus.azurecontainerapps.io/"
            }
        }
      },

      "quote-cluster": {
        "Destinations": {
          "auto-quote-service": {
            "Address": "http://auto-quote-service.internal.livelyisland-a6b04717.eastus.azurecontainerapps.io/"
          }
        }
      }
    }
  },

  "AllowedHosts": "*"
}